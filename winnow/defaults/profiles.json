        {
          "title": "Run / service registry entries",
          "source": "sql",
          "render": "stat",
          "span": 1,
          "sub": "autostart persistence (RECmd)",
          "query": {
            "sql": "SELECT COUNT(*) FROM {{registry}} WHERE KeyPath LIKE '%\\Run' OR KeyPath LIKE '%\\RunOnce' OR KeyPath LIKE '%\\Services%' OR Category LIKE '%Run%' OR Category LIKE '%Service%'"
          },
          "drill": {
            "table": "{{registry}}",
            "tree": {
              "type": "group",
              "op": "OR",
              "children": [
                {
                  "type": "group",
                  "op": "AND",
                  "children": [
                    {
                      "type": "cond",
                      "column": "KeyPath",
                      "op": "regex",
                      "value": "\\\\Run$"
                    }
                  ]
                },
                {
                  "type": "group",
                  "op": "AND",
                  "children": [
                    {
                      "type": "cond",
                      "column": "KeyPath",
                      "op": "regex",
                      "value": "\\\\RunOnce$"
                    }
                  ]
                },
                {
                  "type": "group",
                  "op": "AND",
                  "children": [
                    {
                      "type": "cond",
                      "column": "KeyPath",
                      "op": "contains",
                      "value": "\\Services"
                    }
                  ]
                },
                {
                  "type": "group",
                  "op": "AND",
                  "children": [
                    {
                      "type": "cond",
                      "column": "Category",
                      "op": "contains",
                      "value": "Run"
                    }
                  ]
                },
                {
                  "type": "group",
                  "op": "AND",
                  "children": [
                    {
                      "type": "cond",
                      "column": "Category",
                      "op": "contains",
                      "value": "Service"
